{
  "documentFormatting": {
    "general": {
      "margins": {
        "top": "2cm",
        "bottom": "2cm",
        "right": "1.5cm",
        "left": "3cm"
      },
      "font": {
        "family": "Times New Roman",
        "size": "14pt",
        "lineSpacing": "single"
      },
      "paragraph": {
        "indent": "1.25cm",
        "lastLineMinLength": "1.875cm",
        "hyphenation": {
          "enabled": true,
          "exceptions": ["headings", "figureCaptions", "tableTitles", "keywords"]
        }
      },
      "typography": {
        "dash": "enDash",
        "hyphen": "standard",
        "multiplicationSign": "middleDot"
      },
      "pageNumbering": {
        "style": "arabic",
        "position": "top-right",
        "font": {
          "family": "Times New Roman",
          "size": "12pt"
        },
        "skip": ["titlePage", "assignmentPage", "sectionFirstPage", "appendixFirstPage"]
      }
    },
    "headings": {
      "section": {
        "alignment": "left",
        "style": "bold",
        "case": "sentenceCase",
        "spacingAfter": "18pt"
      },
      "subsection": {
        "alignment": "left",
        "style": "bold",
        "case": "sentenceCase",
        "spacingAfter": "12pt",
        "spacingBefore": "18pt",
        "spacingBeforeAnotherSubSection": "6pt"
      },
      "special": {
        "titles": ["Abstract", "TableOfContents", "Introduction", "Conclusion", "References"],
        "alignment": "center",
        "style": "bold",
        "case": "sentenceCase"
      }
    },
    "tables": {
      "numbering": "{sectionNumber}.{itemNumber} – {Description}",
      "placement": "afterReference",
      "title": {
        "position": "above",
        "alignment": "left",
        "indent": "none",
        "spacingBefore": "14pt"
      },
      "font": {
        "family": "Times New Roman",
        "size": "14pt"
      },
      "alignment": {
        "header": "center",
        "firstColumn": "left",
        "otherColumns": "center"
      },
      "spacingAfter": "14pt",
      "continuation": {
        "label": "Continuation of Table {number}",
        "columnNumbering": "inherit"
      },
      "restrictions": {
        "noSplitTitle": true,
        "noSplitHeader": true,
        "noSectionEnd": true
      }
    },
    "figures": {
      "caption": {
        "position": "below",
        "label": "Рисунок {sectionNumber}.{itemNumber} – {Description}",
        "referenceFormat": "fullWord",
        "alignment": "center"
      },
      "alignment": "center",
      "spacing": {
        "before": "14pt",
        "betweenFigureAndCaption": "6pt",
        "afterCaption": "14pt"
      },
      "restrictions": {
        "noSectionEnd": true
      }
    },
    "lists": {
      "simple": {
        "prefix": "hyphen",
        "indent": "1.25cm",
        "markerSpacing": "nonBreakingSpace",
        "punctuation": "semicolon",
        "finalPunctuation": "period",
        "case": "lowercase"
      },
      "complex": {
        "level1": {
          "prefix": "lowercaseRussianLetter",
          "excludeLetters": ["ё", "й", "з", "о", "ъ", "ы", "ь"],
          "suffix": ")",
          "indent": "1.25cm",
          "markerSpacing": "nonBreakingSpace",
          "punctuation": "semicolon",
          "finalPunctuation": "period",
          "case": "lowercase"
        },
        "level2": {
          "prefix": "arabicNumber",
          "suffix": ")",
          "indent": "relative",
          "markerSpacing": "nonBreakingSpace",
          "punctuation": "semicolon",
          "finalPunctuation": "period",
          "case": "lowercase"
        }
      }
    },
    "formulas": {
      "numbering": {
        "format": "{sectionNumber}.{itemNumber}",
        "position": "left"
      },
      "alignment": "center",
      "spacing": {
        "before": "14pt",
        "after": "14pt"
      },
      "symbols": {
        "multiplication": "middleDot",
        "standards": ["international", "interstate", "national", "industry"]
      },
      "explanation": {
        "position": "below",
        "format": {
          "prefix": "where",
          "noColon": true,
          "newLinePerSymbol": true
        }
      },
      "restrictions": {
        "noSectionEnd": true
      }
    },
    "listings": {
      "font": {
        "family": "Courier New",
        "size": "12pt",
        "lineSpacing": "single"
      },
      "frame": true,
      "numbering": "Листинг {sectionNumber}.{itemNumber} – {Description}",
      "placement": {
        "maxPageCoverage": "70%",
        "moveToAppendixIfExceeds": true,
        "noPageBreak": true
      },
      "spacing": {
        "before": "14pt",
        "betweenListingAndCaption": "6pt",
        "afterCaption": "14pt"
      },
      "formatting": {
        "blockSeparation": "emptyLines",
        "nestedIndentation": "2spaces"
      },
      "referenceFormat": "fullWord",
      "restrictions": {
        "noSectionEnd": true
      }
    },
    "references": {
      "format": "squareBrackets",
      "list": {
        "indent": "1.25cm",
        "noDotAfterNumber": true,
        "order": "appearance",
        "standard": "GOST 7.1-2003"
      }
    },
    "numbers": {
      "oneToNine": "words",
      "exceptions": ["sectionReferences"]
    },
    "abstract": {
      "maxPages": 1,
      "languages": ["main", "foreign"],
      "content": [
        {
          "type": "volumeInfo",
          "items": ["totalPages", "illustrations", "tables", "sources", "appendices"],
          "omitIfAbsent": ["tables", "appendices"]
        },
        {
          "type": "keywords",
          "minCount": 5,
          "maxCount": 15,
          "case": "uppercase",
          "separator": ",",
          "noHyphenation": true,
          "noFinalDot": true
        },
        {
          "type": "text",
          "items": [
            "object",
            "goal",
            "results",
            "technicalCharacteristics",
            "implementation",
            "impact"
          ],
          "researchAdditions": {
            "methodology": "afterGoal"
          }
        },
        {
          "type": "graphicMaterial",
          "format": "A1Equivalent",
          "standard": "GOST 2.301"
        }
      ],
      "title": {
        "text": "Abstract",
        "alignment": "center",
        "style": "bold",
        "case": "sentenceCase"
      }
    },
    "tableOfContents": {
      "title": {
        "text": "Table of Contents",
        "alignment": "center",
        "style": "bold",
        "case": "sentenceCase"
      },
      "items": [
        "abstracts",
        "introduction",
        "sections",
        "subsections",
        "conclusion",
        "references",
        "graphicMaterial",
        "appendices"
      ],
      "pageNumbers": {
        "style": "arabic",
        "alignment": "right",
        "noPunctuation": true
      }
    },
    "structure": {
      "order": [
        "titlePage",
        "assignmentPage",
        "tableOfContents",
        "abstractMain",
        "abstractForeign",
        "introduction",
        "sections",
        "conclusion",
        "references",
        "graphicMaterial",
        "technicalDocuments",
        "appendices"
      ],
      "assignmentPage": {
        "printing": "doubleSided",
        "margins": "mirrored"
      },
      "volume": {
        "minPages": 60,
        "maxPages": 100,
        "excludes": ["appendices"]
      },
      "sectionFrame": {
        "onFirstPage": true,
        "exclude": ["titlePage", "assignmentPage", "appendices"],
        "content": {
          "bottomRight": ["UniversityCode", "SpecialtyCode", "DefenseYear"],
          "pageField": {
            "first": "1",
            "total": "sectionPages"
          },
          "consultant": {
            "sections": ["economic"],
            "position": "freeCell"
          }
        }
      }
    }
  }
}