#include <Python.h>
#include <windows.h>
#include <intrin.h>
#include <stdint.h>
#include <string.h>
#include <openssl/sha.h>
#include <iphlpapi.h>
#pragma comment(lib, "iphlpapi.lib")

#define HASH_SIZE 128

static uint32_t g_function_hash = 0;

static uint32_t compute_hash(void* func, size_t size) {
    uint8_t* p = (uint8_t*)func;
    uint32_t hash = 0;
    for (size_t i = 0; i < size; i++)
        hash += p[i];
    return hash;
}

static int check_function_integrity(void* func, size_t size) {
    return compute_hash(func, size) == g_function_hash;
}

// --- Получение MachineGuid ---
static int get_machine_guid(char* out_guid, DWORD out_size) {
    HKEY hKey;
    if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Microsoft\\Cryptography",
                      0, KEY_READ | KEY_WOW64_64KEY, &hKey) != ERROR_SUCCESS)
        return 0;

    DWORD dwType = REG_SZ;
    DWORD dwSize = out_size;
    LONG ret = RegQueryValueExA(hKey, "MachineGuid", NULL, &dwType,
                                (LPBYTE)out_guid, &dwSize);
    RegCloseKey(hKey);

    for (DWORD i = 0; i < dwSize && out_guid[i]; i++)
        out_guid[i] ^= 0xAA + 0x55; // более сложное XOR

    return (ret == ERROR_SUCCESS);
}

// --- Получение CPU ID ---
static void get_cpu_id(char* buffer, size_t bufsize) {
    int cpu_info[4] = {0};
    __cpuid(cpu_info, 1);
    snprintf(buffer, bufsize, "%08X%08X%08X%08X", cpu_info[0], cpu_info[1], cpu_info[2], cpu_info[3]);
}

// --- Получение диска ---
static DWORD get_disk_serial(const char* drive) {
    DWORD serial = 0;
    GetVolumeInformationA(drive, NULL, 0, &serial, NULL, NULL, NULL, 0);
    return serial;
}

// --- Получение MAC-адресов ---
static void get_mac_addresses(char* buffer, size_t bufsize) {
    IP_ADAPTER_INFO AdapterInfo[16];
    DWORD dwBufLen = sizeof(AdapterInfo);
    if (GetAdaptersInfo(AdapterInfo, &dwBufLen) == ERROR_SUCCESS) {
        PIP_ADAPTER_INFO pAdapter = AdapterInfo;
        while (pAdapter) {
            for (UINT i = 0; i < pAdapter->AddressLength; i++)
                snprintf(buffer + strlen(buffer), bufsize - strlen(buffer), "%02X", pAdapter->Address[i]);
            pAdapter = pAdapter->Next;
        }
    }
}

// --- Генерация HWID ---
static PyObject* generate_hwid(PyObject* self, PyObject* args) {
    if (!check_function_integrity((void*)generate_hwid, HASH_SIZE))
        return Py_BuildValue("s", "TAMPERED");

    char buffer[512] = {0};
    char tmp[128] = {0};

    // CPU ID
    get_cpu_id(tmp, sizeof(tmp));
    strncat(buffer, tmp, sizeof(buffer)-strlen(buffer)-1);

    // Диск
    snprintf(tmp, sizeof(tmp), "%08X", get_disk_serial("C:\\"));
    strncat(buffer, tmp, sizeof(buffer)-strlen(buffer)-1);

    // Machine GUID
    if (get_machine_guid(tmp, sizeof(tmp))) {
        for (int i = 0; i < strlen(tmp); i++) tmp[i] ^= 0xAA + 0x55;
        strncat(buffer, tmp, sizeof(buffer)-strlen(buffer)-1);
    }

    // MAC-адреса
    get_mac_addresses(tmp, sizeof(tmp));
    strncat(buffer, tmp, sizeof(buffer)-strlen(buffer)-1);

    // SHA256
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256((unsigned char*)buffer, strlen(buffer), hash);

    char hwid[65] = {0};
    for (int i = 0; i < SHA256_DIGEST_LENGTH; i++)
        sprintf(hwid + i*2, "%02x", hash[i]);

    return Py_BuildValue("s", hwid);
}

static PyMethodDef HwidMethods[] = {
    {"get_hwid", generate_hwid, METH_NOARGS, "Generate HWID with anti-tamper"},
    {NULL, NULL, 0, NULL}
};

static struct PyModuleDef hwidmodule = {
    PyModuleDef_HEAD_INIT,
    "hwid_validate",
    NULL,
    -1,
    HwidMethods
};

PyMODINIT_FUNC PyInit_hwid_validate(void) {
    g_function_hash = compute_hash((void*)generate_hwid, HASH_SIZE);
    return PyModule_Create(&hwidmodule);
}
